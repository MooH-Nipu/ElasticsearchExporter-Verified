# Elasticsearch URL. HTTPS fingerprints are retrieved automatically on first connection.
ELASTICSEARCH_URL=https://192.168.31.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
# Optional. Leave blank to scan and choose from existing indexes.
ELASTICSEARCH_INDEX=
# Optional. Leave blank to export every document from the index.
QUERY_FILE=filter.json
# Optional legacy Elasticsearch-side field filter. Post-filtering is more compatible.
PROMPT_FIELD_FILTER=false
BACKUP_FOLDER=exported
# json writes newline-delimited JSON (.ndjson); csv writes only .csv.
OUTPUT_FORMAT=json
# Optional. Leave blank to choose at runtime.
OUTPUT_NAME=
# Set false to skip date/time prompts.
PROMPT_TIME_RANGE=true
# Bare date/time input is treated as WIB (UTC+7).
LOCAL_UTC_OFFSET=7
# Convert exported TIMESTAMP_FIELD values to UTC+7.
EXPORT_UTC_OFFSET=7
# Smaller pages and a short pause reduce sustained CPU pressure.
PAGE_SIZE=2000
REQUEST_TIMEOUT=120
PAGE_DELAY=0.05

# Safer than automatic trust-on-first-use. Optional SHA-256 certificate fingerprint.
# ELASTICSEARCH_CERT_FINGERPRINT=AA:BB:CC:DD

# Optional settings
# TIMESTAMP_FIELD=@timestamp
# TIME_SERIES=true
# DEBUG=false
